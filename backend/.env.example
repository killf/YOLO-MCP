# 默认数据目录为用户主目录下的 .yolo-mcp，可按需覆盖。
# YOLO_MCP_DATA_DIR=~/.yolo-mcp

# 默认 SQLite 位于 YOLO_MCP_DATA_DIR/labels.sqlite，可按需指定其他数据库。
# YOLO_MCP_DATABASE_URL=sqlite:///your/custom/labels.sqlite

# 签名密钥首次启动时自动生成到 YOLO_MCP_DATA_DIR/secret.key，后续启动复用。

# AI 和页面训练复用当前 Python 的 GPU 环境；留空自动选择设备。
YOLO_MCP_USE_AUTO_LABEL=true
YOLO_MCP_DEVICE=

# 配置 kubeconfig 后，页面与 MCP 训练在 Kubernetes 的单张 NVIDIA GPU 上执行。
# 路径由本机后端读取；namespace 必须预先存在，镜像由集群拉取。
# YOLO_MCP_KUBECONFIG=C:/Users/your-name/.kube/config
# YOLO_MCP_K8S_NAMESPACE=training
# YOLO_MCP_K8S_IMAGE=ultralytics/ultralytics:latest

# 火山引擎 VCI：设置 GPU 规格族后强制申请 VCI；驱动必须与训练镜像 CUDA 匹配。
# YOLO_MCP_K8S_VCI_INSTANCE_FAMILY=vci.gni3
# YOLO_MCP_K8S_VCI_GPU_DRIVER_VERSION=tesla-570.195.03
# YOLO_MCP_K8S_VCI_ZONE=cn-beijing-a

# MCP 默认只接受本机地址。远程部署时填写实际域名与来源的 JSON 数组。
# YOLO_MCP_MCP_ALLOWED_HOSTS=["yolo.example.com"]
# YOLO_MCP_MCP_ALLOWED_ORIGINS=["https://yolo.example.com"]
