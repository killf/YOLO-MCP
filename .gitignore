# 环境、凭据和本地运行文件。
.env
.env.*
!.env.example
secret.key
.venv/
.venv-*/
.tmp/
.cache/
/data/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db
*.log

# Python 与前端依赖、缓存和构建产物。
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# 模型权重和训练输出保存在本地数据目录，不纳入版本控制。
*.pt
*.onnx
*.engine

# 前端静态资源在构建时生成。
/backend/statics/*
!/backend/statics/__init__.py

.DS_Store
Thumbs.db

# 后端运行数据与训练工作目录。
/backend/data/
/backend/workspace/
